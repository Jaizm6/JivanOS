{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JivanOS",
  "version": "3.0.0",
  "identifier": "com.jaiz.jivanos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JivanOS",
        "width": 420,
        "height": 820,
        "minWidth": 380,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "JivanOS",
    "category": "Productivity",
    "shortDescription": "Privacy-first local-first personal life operating system",
    "longDescription": "JivanOS unifies tasks, schedules, habits, medications, hydration, bills, goals, and encrypted multi-provider cloud sync in a compact desktop companion.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libsecret-1-0"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^https://.*$"
    }
  }
}
