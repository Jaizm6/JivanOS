{
  "entities": {
    "UserSyncDoc": {
      "title": "UserSyncDoc",
      "description": "Authenticated user's legacy synchronized JivanOS state and profile snapshot",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 320,
          "description": "Owner account email address"
        },
        "payload": {
          "type": "string",
          "maxLength": 950000,
          "description": "Serialized or AES-256-GCM encrypted JivanOS snapshot JSON"
        },
        "clientVersion": {
          "type": "number",
          "description": "Schema version of client sync engine"
        },
        "provider": {
          "type": "string",
          "maxLength": 64,
          "description": "Active sync target provider identifier"
        },
        "source": {
          "type": "string",
          "maxLength": 32,
          "description": "Sync trigger source (manual or auto)"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of snapshot creation"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last write"
        }
      },
      "required": ["payload", "updatedAt"]
    },
    "UserData": {
      "title": "UserData",
      "description": "User state data payload for backup subcollection",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 320
        },
        "payload": {
          "type": "string",
          "maxLength": 950000
        },
        "version": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["userId", "payload", "updatedAt"]
    },
    "QuoteReminder": {
      "title": "QuoteReminder",
      "description": "User scheduled quote reminders",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "quoteId": {
          "type": "string",
          "maxLength": 128
        },
        "reminderTime": {
          "type": "string",
          "maxLength": 32
        },
        "enabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["userId", "quoteId", "reminderTime", "enabled"]
    },
    "JivanCloudBackup": {
      "title": "JivanCloudBackup",
      "description": "Phase 5A JivanOS Cloud real-time backup document synced via Firestore",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemaVersion": {
          "type": "number"
        },
        "app": {
          "type": "string",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server Timestamp"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "maxLength": 120
        },
        "platform": {
          "type": "string",
          "maxLength": 32
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "trial", "expired"]
        },
        "data": {
          "type": "object",
          "description": "Structured JivanOS collections map (tasks, habits, bills, medications, settings, etc.)"
        }
      },
      "required": ["userId", "schemaVersion", "app", "updatedAt", "deviceId", "subscriptionStatus", "data"]
    },
    "JivanCloudSubscription": {
      "title": "JivanCloudSubscription",
      "description": "Server-managed JivanOS Cloud paid subscription document (read-only for client)",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "expired"]
        },
        "plan": {
          "type": "string",
          "enum": ["monthly", "yearly"]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["status", "expiresAt"]
    },
    "JivanCloudTrial": {
      "title": "JivanCloudTrial",
      "description": "Create-once immutable 14-day free trial document verified against server clock",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trialStartedAt": {
          "type": "string",
          "format": "date-time"
        },
        "trialEndsAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "trialStartedAt", "trialEndsAt"]
    },
    "JivanCloudSyncHistoryEntry": {
      "title": "JivanCloudSyncHistoryEntry",
      "description": "Individual sync event entry (last 10 retained per user)",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceName": {
          "type": "string",
          "maxLength": 120
        },
        "platform": {
          "type": "string",
          "maxLength": 32
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "itemCounts": {
          "type": "object"
        }
      },
      "required": ["userId", "deviceId", "deviceName", "platform", "timestamp", "itemCounts"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserSyncDoc",
      "description": "Authenticated user's primary sync & backup state document"
    },
    "/users/{userId}/data/state": {
      "schema": "UserData",
      "description": "User encrypted state and full backup data"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "QuoteReminder",
      "description": "User scheduled quote reminders"
    },
    "/users/{userId}/jivanos/backup": {
      "schema": "JivanCloudBackup",
      "description": "Phase 5A JivanOS Cloud real-time Firestore backup document"
    },
    "/users/{userId}/jivanos/subscription": {
      "schema": "JivanCloudSubscription",
      "description": "Server-managed subscription state (readable by owner, not writable by client)"
    },
    "/users/{userId}/jivanos/trial": {
      "schema": "JivanCloudTrial",
      "description": "Create-once immutable 14-day free trial record"
    },
    "/users/{userId}/jivanos/backup/syncHistory/{entryId}": {
      "schema": "JivanCloudSyncHistoryEntry",
      "description": "Last 10 sync history records per user"
    }
  }
}
